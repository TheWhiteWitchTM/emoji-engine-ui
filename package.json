{
  "name": "emoji-engine-ui",
  "version": "0.1.0",
  "description": "Borland and Linux console widgets for emoji-engine-2d and emoji-engine-3d. One cell surface, mouse and keys.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "browser",
    "src",
    "examples",
    "ARCHITECTURE.md",
    "CHANGES.md",
    "INTERFACES.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node build.js",
    "prepare": "npm run build",
    "demo": "npm run build && node examples/demo.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
